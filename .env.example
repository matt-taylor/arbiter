# ─────────────────────────────────────────────────────────────────────────────
# Arbiter Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and adjust values for your environment.
# Lines beginning with # are comments. Uncommented values show the defaults.

# ═══════════════════════════════════════════════════════════════════════════════
# CORE SERVER (required)
# ═══════════════════════════════════════════════════════════════════════════════

# Address and port the Arbiter HTTP server listens on.
# Example: "127.0.0.1:9191" or ":9191" (all interfaces)
ARBITER_BIND_ADDR=127.0.0.1:9191

# SQLite database URL for host policies.
# Path to the SQLite database file used for policy storage.
DATABASE_URL=file:arbiter.db?_journal_mode=WAL

# ═══════════════════════════════════════════════════════════════════════════════
# DOWNSTREAM SERVICES (required)
# ═══════════════════════════════════════════════════════════════════════════════

# Base URL for Killswitch. Arbiter sends auth_request checks here.
KILLSWITCH_BASE_URL=http://127.0.0.1:9090

# Base URL for Gatekeeper. Arbiter sends authorization checks here.
GATEKEEPER_BASE_URL=http://192.168.4.201:3000

# ═══════════════════════════════════════════════════════════════════════════════
# DOWNSTREAM TIMEOUTS (optional)
# ═══════════════════════════════════════════════════════════════════════════════

# Timeout in milliseconds for Killswitch HTTP calls. Fail-closed on timeout.
# KILLSWITCH_TIMEOUT_MS=1500

# Timeout in milliseconds for Gatekeeper HTTP calls. Fail-closed on timeout.
# GATEKEEPER_TIMEOUT_MS=1500

# ═══════════════════════════════════════════════════════════════════════════════
# POLICY CACHE (optional)
# ═══════════════════════════════════════════════════════════════════════════════

# How long (in seconds) host policies are cached in memory before re-reading
# from SQLite. Lower values = fresher policies, higher values = less DB I/O.
# CACHE_TTL_SECONDS=600

# ═══════════════════════════════════════════════════════════════════════════════
# FORCED HOST CONSTRAINTS (optional)
# ═══════════════════════════════════════════════════════════════════════════════

# Public hostname of Killswitch. When a request is for this host, Arbiter
# skips the Killswitch check to prevent infinite recursion.
# KILLSWITCH_PUBLIC_HOST=killswitch.domostack.me

# Public hostname of Gatekeeper. When a request is for this host, Arbiter
# skips the Gatekeeper check to prevent infinite recursion.
# GATEKEEPER_PUBLIC_HOST=gatekeeper.domostack.me

# ═══════════════════════════════════════════════════════════════════════════════
# TELEMETRY PUBLISHER (optional — Arbiter server side)
# ═══════════════════════════════════════════════════════════════════════════════
# These control the fire-and-forget Redis publisher that emits telemetry events
# from the Arbiter server process. Events are written to a Redis Stream.

# Enable telemetry event publishing. When false, no events are emitted.
# ARB_TELEMETRY_ENABLED=false

# Redis connection URL for the telemetry event stream.
# ARB_TELEMETRY_REDIS_URL=redis://localhost:6379/0

# Redis Stream key where telemetry events are published.
# ARB_TELEMETRY_STREAM_KEY=arb:v1:events

# Max time (ms) to wait for a Redis XADD before dropping the event.
# Keep this low to avoid adding latency to the auth_request path.
# ARB_TELEMETRY_TIMEOUT_MS=25

# In-memory buffer size for the async publisher. Events are dropped when full.
# ARB_TELEMETRY_BUFFER_SIZE=8192

# ═══════════════════════════════════════════════════════════════════════════════
# TELEMETRY CONSUMER (arbiter-telemetry-consumer binary)
# ═══════════════════════════════════════════════════════════════════════════════
# These control the separate consumer binary that reads from the Redis Stream
# and writes aggregated rollups into MariaDB.

# Enable the telemetry consumer. When false, the binary exits immediately.
# ARB_TELEMETRY_CONSUMER_ENABLED=false

# Redis connection URL for reading the telemetry event stream.
# ARB_TELEMETRY_REDIS_URL=redis://localhost:6379/0

# Redis Stream key to consume events from. Must match the publisher's key.
# ARB_TELEMETRY_STREAM_KEY=arb:v1:events

# Redis consumer group name. All consumer instances in the same group share
# the workload (each event is delivered to exactly one consumer in the group).
# ARB_TELEMETRY_CONSUMER_GROUP=arbiter-telemetry-v1

# Consumer name within the group. Defaults to "<hostname>-<pid>".
# Useful for distinguishing multiple consumers in monitoring.
# ARB_TELEMETRY_CONSUMER_NAME=

# Where to start reading when the consumer group is first created:
# "$" = only new messages (default), "0" = replay from the beginning.
# ARB_TELEMETRY_GROUP_START_ID=$

# Max events to read per XREADGROUP call.
# ARB_TELEMETRY_READ_COUNT=1000

# Max time (ms) to block on XREADGROUP when no events are available.
# ARB_TELEMETRY_BLOCK_MS=200

# How often (ms) the consumer flushes accumulated counters to MariaDB.
# Lower = more frequent writes with fresher data. Higher = fewer writes.
# ARB_TELEMETRY_FLUSH_MS=1000

# Max distinct paths tracked per (host, ip) pair in a single flush cycle.
# Paths beyond this cap are silently dropped to bound memory usage.
# ARB_TELEMETRY_PATH_CAP=50

# MariaDB DSN for the consumer to write rollup data.
# Format: user:password@tcp(host:port)/database
# parseTime=true and loc=UTC are appended automatically if missing.
# ARB_TELEMETRY_DB_DSN=arbiter:arbiter_dev@tcp(127.0.0.1:3306)/arbiter_telemetry

# Number of days to retain rollup data. Used by the maintenance cron script
# (not enforced by the consumer itself).
# ARB_TELEMETRY_RETENTION_DAYS=7

# Enable PEL (Pending Entries List) claim via XAUTOCLAIM.
# When true, the consumer periodically claims messages that other consumers
# have read but not acknowledged (e.g., after a crash).
# ARB_TELEMETRY_PEL_CLAIM_ENABLED=false

# How long (ms) a message must be idle (unacknowledged) before it can be claimed.
# ARB_TELEMETRY_PEL_IDLE_MS=300000

# Max number of messages to claim per XAUTOCLAIM call.
# ARB_TELEMETRY_PEL_CLAIM_COUNT=1000

# ═══════════════════════════════════════════════════════════════════════════════
# TELEMETRY QUERY API (optional — served by the Arbiter server)
# ═══════════════════════════════════════════════════════════════════════════════
# These control the read-only REST API that the telemetry frontend consumes.
# The API queries the same MariaDB rollup tables written by the consumer.

# Enable the telemetry query API endpoints. When false, the /telemetry routes
# are not registered and MariaDB is not connected.
# ARB_TELEMETRY_API_ENABLED=false

# MariaDB DSN for the query API (read-only access is sufficient).
# Format: user:password@tcp(host:port)/database
# Should point to the same database as ARB_TELEMETRY_DB_DSN.
# ARB_TELEMETRY_API_DB_DSN=

# Max allowed value for the window_minutes query parameter.
# Limits how far back in time a single query can look.
# ARB_TELEMETRY_API_MAX_WINDOW_MINUTES=60

# Max allowed value for the limit query parameter.
# Limits how many rows a single query can return.
# ARB_TELEMETRY_API_MAX_LIMIT=100

# Whether to trust X-Real-IP / X-Forwarded-For headers for rate limiting.
# Set to true when Arbiter sits behind NGINX (production).
# Set to false if Arbiter is directly exposed (uses RemoteAddr only).
# ARB_TELEMETRY_API_TRUST_PROXY_HEADERS=true

# ═══════════════════════════════════════════════════════════════════════════════
# TELEMETRY OVERVIEW THRESHOLDS (optional — tuning for overview endpoints)
# ═══════════════════════════════════════════════════════════════════════════════
# These control the detection sensitivity of the overview/suspicious-scanners
# and overview/suspicious-sprayers endpoints. All have sensible defaults.

# ── Scanner Thresholds ──

# Minimum number of unique paths an IP must hit on a single host to appear
# as a scanner candidate. IPs below this are filtered out at the database level.
# Lower = more candidates (noisier), higher = fewer candidates (stricter).
# ARB_TELEMETRY_SCANNER_NOISE_FLOOR=10

# Maximum number of scanner candidates returned from the Stage 1 SQL query.
# This is a hard cap to bound query cost, not a display limit.
# ARB_TELEMETRY_SCANNER_CANDIDATE_CAP=200

# Maximum number of scanner candidates enriched per Stage 2 query batch.
# Larger batches = fewer queries but bigger SQL statements.
# ARB_TELEMETRY_SCANNER_ENRICH_BATCH=100

# Unique path count at which a scanner candidate earns the
# SCAN_SINGLE_HOST reason flag. This is a display-level threshold;
# candidates with fewer paths still appear but without this flag.
# ARB_TELEMETRY_SCANNER_PATH_THRESHOLD=30

# ── Sprayer Thresholds ──

# Unique host count at which a sprayer candidate earns the
# SPRAY_HOSTS reason flag. IPs hitting fewer hosts still appear
# in the sprayers table but without this flag.
# ARB_TELEMETRY_SPRAYER_HOST_THRESHOLD=5

# ── Shared Reason-Flag Thresholds ──

# Burstiness ratio (peak_rps / avg_rps) at which any candidate earns
# the BURSTY reason flag. Higher values = only flag extreme bursts.
# ARB_TELEMETRY_BURSTINESS_THRESHOLD=5.0

# Peak requests-per-second at which any candidate earns the HIGH_PEAK
# reason flag. Based on the highest 10-second bucket in the window.
# ARB_TELEMETRY_PEAK_RPS_THRESHOLD=10.0

# ═══════════════════════════════════════════════════════════════════════════════
# DOCKER COMPOSE DEV (used by docker-compose.dev.yml and Makefile)
# ═══════════════════════════════════════════════════════════════════════════════

MYSQL_ROOT_PASSWORD=changeme
MYSQL_DATABASE=arbiter_telemetry
MYSQL_USER=arbiter
MYSQL_PASSWORD=arbiter_dev
MYSQL_PORT=3306

# ╔═══════════════════════════════════════════════════════════════════════╗
# ║                    Arbiter Environment Variables                     ║
# ╚═══════════════════════════════════════════════════════════════════════╝
#
# Copy this file to .env and adjust values for your environment.
# All variables with defaults are optional unless noted.

# ──────────────────────────────────────────────────────────────────────────
# Core (Required)
# ──────────────────────────────────────────────────────────────────────────

# Address the Arbiter HTTP server binds to (host:port)
ARBITER_BIND_ADDR=0.0.0.0:9199

# SQLite database URL for host policies
DATABASE_URL=file:arbiter.db?cache=shared&mode=rwc&_journal_mode=WAL

# Base URL for the Killswitch downstream service
KILLSWITCH_BASE_URL=http://localhost:8080

# Base URL for the Gatekeeper downstream service
GATEKEEPER_BASE_URL=http://localhost:3000

# ──────────────────────────────────────────────────────────────────────────
# Timeouts & Cache (Optional)
# ──────────────────────────────────────────────────────────────────────────

# Timeout in milliseconds for Killswitch HTTP calls (default: 1500)
KILLSWITCH_TIMEOUT_MS=1500

# Timeout in milliseconds for Gatekeeper HTTP calls (default: 1500)
GATEKEEPER_TIMEOUT_MS=1500

# Policy cache TTL in seconds (default: 600)
CACHE_TTL_SECONDS=600

# ──────────────────────────────────────────────────────────────────────────
# Public Host Overrides (Optional)
# ──────────────────────────────────────────────────────────────────────────

# Override the Host header sent to Killswitch (anti-recursion).
# Useful when Killswitch is behind the same NGINX and Arbiter must
# avoid triggering its own auth_request subrequest.
# KILLSWITCH_PUBLIC_HOST=killswitch.example.com

# Override the Host header sent to Gatekeeper (same anti-recursion use).
# GATEKEEPER_PUBLIC_HOST=gatekeeper.example.com

# ──────────────────────────────────────────────────────────────────────────
# Telemetry Publisher (Optional)
# ──────────────────────────────────────────────────────────────────────────
# Emits per-request events to a Redis Stream for the telemetry consumer
# to roll up into MariaDB.

# Enable telemetry event publishing (default: false)
ARB_TELEMETRY_ENABLED=false

# Redis connection URL for the telemetry stream (default: redis://localhost:6379/0)
ARB_TELEMETRY_REDIS_URL=redis://localhost:6379/0

# Redis Stream key for telemetry events (default: arb:v1:events)
ARB_TELEMETRY_STREAM_KEY=arb:v1:events

# Max milliseconds to wait for a Redis XADD before dropping the event (default: 25)
ARB_TELEMETRY_TIMEOUT_MS=25

# In-memory ring buffer size for batching events (default: 8192)
ARB_TELEMETRY_BUFFER_SIZE=8192

# ──────────────────────────────────────────────────────────────────────────
# Telemetry Query API (Optional)
# ──────────────────────────────────────────────────────────────────────────
# Read-only REST endpoints that serve rollup data from MariaDB.

# Enable the telemetry query API (default: false)
ARB_TELEMETRY_API_ENABLED=false

# MariaDB DSN for the telemetry database.
# Required when ARB_TELEMETRY_API_ENABLED=true.
# Format: user:password@tcp(host:port)/database
ARB_TELEMETRY_API_DB_DSN=arbiter:arbiter_dev@tcp(127.0.0.1:3306)/arbiter_telemetry

# Maximum allowed window_minutes query parameter (default: 60)
ARB_TELEMETRY_API_MAX_WINDOW_MINUTES=60

# Maximum allowed limit query parameter (default: 100)
ARB_TELEMETRY_API_MAX_LIMIT=100

# Trust X-Forwarded-For / X-Real-IP for rate-limiting (default: true)
ARB_TELEMETRY_API_TRUST_PROXY_HEADERS=true

# ──────────────────────────────────────────────────────────────────────────
# Telemetry Overview: Scanner Thresholds
# ──────────────────────────────────────────────────────────────────────────
# Scanners = IPs hitting many unique paths on a single host.

# Minimum number of unique paths an IP must hit on a host to be considered
# a scanner candidate in Stage 1 SQL (default: 10)
ARB_TELEMETRY_SCANNER_NOISE_FLOOR=10

# Maximum number of scanner candidates returned by Stage 1 SQL (default: 200)
ARB_TELEMETRY_SCANNER_CANDIDATE_CAP=200

# Maximum number of candidates per Stage 2 enrichment query batch (default: 100)
ARB_TELEMETRY_SCANNER_ENRICH_BATCH=100

# Unique paths threshold to earn the SCAN_SINGLE_HOST reason flag (default: 30)
ARB_TELEMETRY_SCANNER_PATH_THRESHOLD=30

# ──────────────────────────────────────────────────────────────────────────
# Telemetry Overview: Sprayer Thresholds
# ──────────────────────────────────────────────────────────────────────────
# Sprayers = IPs hitting many unique hosts.

# Unique hosts threshold to earn the SPRAY_HOSTS reason flag (default: 5)
ARB_TELEMETRY_SPRAYER_HOST_THRESHOLD=5

# ──────────────────────────────────────────────────────────────────────────
# Telemetry Overview: Flooder Thresholds
# ──────────────────────────────────────────────────────────────────────────
# Flooders = IPs hammering a single path on a single host (brute-force/flood).

# Minimum total requests to a single (host, ip, path) triple to be considered
# a flooder candidate in Stage 1 SQL (default: 50)
ARB_TELEMETRY_FLOODER_MIN_TOTAL=50

# Maximum number of flooder candidates returned by Stage 1 SQL (default: 200)
ARB_TELEMETRY_FLOODER_CANDIDATE_CAP=200

# Maximum unique paths an IP can have on a host to still qualify as a flooder.
# IPs with more paths than this are filtered out in Stage 2 enrichment.
# Also used as the threshold for the FLOOD_SINGLE_PATH reason flag. (default: 3)
ARB_TELEMETRY_FLOODER_MAX_PATHS=3

# ──────────────────────────────────────────────────────────────────────────
# Telemetry Overview: Shared Reason-Flag Thresholds
# ──────────────────────────────────────────────────────────────────────────
# These apply to scanners, sprayers, and flooders alike.

# Burstiness ratio (peak_rps / avg_rps) to earn the BURSTY reason flag (default: 5.0)
ARB_TELEMETRY_BURSTINESS_THRESHOLD=5.0

# Peak RPS to earn the HIGH_PEAK reason flag (default: 10.0)
ARB_TELEMETRY_PEAK_RPS_THRESHOLD=10.0
